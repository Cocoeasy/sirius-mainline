index 0000000000000000000000000000000000000000..df979299b3db41042e5ef917c8ffc69f898d92f4
--- /dev/null
+++ b/drivers/gpu/drm/panel/panel-samsung-ea8074.c
@@ -0,0 +1,671 @@
+// SPDX-License-Identifier: GPL-2.0-only
+/*
+ * Panel driver for the Samsung EA8074 1080x2244 command mode AMOLED panel
+ * found in the Xiaomi Mi 8 SE (xiaomi-sirius, SDM710).
+ *
+ * Every hardware value in this file comes from pinned sources. Nothing was
+ * guessed and nothing was taken from a different panel:
+ *
+ *  - panel data (mode, lanes, reset waveform, supply order + delays, on/off
+ *    command arrays, brightness encoding) comes from Sirius' read-only
+ *    evidence fixture and the downstream sources it pins:
+ *      /sys/firmware/fdt of the device (recovery, read only)
+ *      SDM710-Development/android_kernel_xiaomi_sdm710
+ *        @06a01bad75939c58be53418f5d71d9d2e25634cf
+ *        arch/arm64/boot/dts/qcom/dsi-panel-ss-fhd-ea8074-cmd.dtsi
+ *        drivers/gpu/drm/msm/dsi-staging/dsi_panel.c, dsi_pwr.c
+ *  - kernel API usage follows the pinned upstream tree
+ *      sdm670-mainline/linux @75d5a9875202673b11a8eac05e6f489ba0c87a05
+ *      drivers/gpu/drm/panel/panel-samsung-ams639rq08.c  (same SoC, same
+ *      vendor, command mode AMOLED, same DSI host) together with the
+ *      exported DRM panel / MIPI DSI / backlight helpers of that tree.
+ *
+ * The on- and off-command arrays are sent with the exact vendor byte order.
+ * Three wire-format details of the vendor arrays differ from what the pinned
+ * kernel's exported DSI helpers emit, and both of the deliberate ones are
+ * documented inline where the records are written (ea8074_on(),
+ * ea8074_off_display(), ea8074_sleep_in()) and summarised here so a reviewer
+ * can check them in one place:
+ *
+ *  1. A vendor record with data type 0x05 and a 2-byte payload carries the DCS
+ *     command in byte 0 and a 0x00 padding byte in byte 1. 0x05 is a short
+ *     write *without* parameters, so byte 1 must not be sent as a parameter;
+ *     those records are emitted as the one-byte DCS command.
+ *  2. 13 vendor records use data type 0x39 (long write) with a 2-byte payload
+ *     = one DCS command plus one parameter. The exported helper derives the
+ *     data type from the transmit buffer length (1 -> 0x05, 2 -> 0x15,
+ *     >= 3 -> 0x39, see mipi_dsi_dcs_write_buffer()) and this kernel exports no
+ *     helper that can force a 0x39 long write for a 1-parameter DCS command,
+ *     so those records go out as 0x15 (short write with one parameter). The DCS
+ *     command byte and its parameter are unchanged; only the packet data type
+ *     differs from the vendor array. Records with 3, 5 and 8 payload bytes keep
+ *     0x39.
+ *
+ *     THIS DIFFERENCE IS AN OPEN HARDWARE RISK, NOT A VERIFIED EQUIVALENCE.
+ *     The panel demonstrably accepts 0x39 here (the vendor kernel honours the
+ *     data type recorded in its own device tree); whether it also accepts 0x15
+ *     for the same command/parameter pair is not established by any pinned
+ *     source and cannot be settled without the panel. It is recorded as a
+ *     blocker in config/ea8074-evidence.json (packet_type_deviation) and is
+ *     asserted record-by-record by scripts/gen_ea8074_cmd_table.py, so it can
+ *     neither be silently dropped nor be mistaken for packet equivalence.
+ *     Closing it needs either hardware confirmation, or a minimal typed-DCS
+ *     helper in the DRM core (design: an additive wrapper next to
+ *     mipi_dsi_dcs_write_buffer() that takes the DCS data type explicitly,
+ *     validates it against the DCS types and the payload length, keeps going
+ *     through the same mipi_dsi_device_transfer() path so host, runtime-PM and
+ *     core checks are unchanged, and is EXPORT_SYMBOL_GPL'd like its
+ *     neighbours). That core change is deliberately not part of this patch: it
+ *     touches shared DRM code and is queued for an independent safety review.
+ *
+ *  3. Transmission state. The vendor device tree sets qcom,mdss-dsi-lp11-init
+ *     (dtsi L36) and gives both command arrays state dsi_lp_mode (L137, L138),
+ *     so the on/off sequences are LP; the downstream brightness path goes
+ *     through the standard helper with no LP flag set, so the 0x51 writes are
+ *     HS. This driver expresses that with MIPI_DSI_MODE_LPM, but not
+ *     continuously: the flag covers the command sequences and is cleared for
+ *     the duration of a brightness write, with a mutex serialising the two.
+ *     See ea8074_bl_update_status() for the derivation and the citations.
+ *
+ * Not implemented on purpose (no pinned data, and not needed for bring-up):
+ * HBM, HDR, ACL/dimming, CRC/seed commands, DC dimming LUT, doze modes and the
+ * ESD error IRQ. Keep them out until each one has its own evidence.
+ */
+
+#include <linux/backlight.h>
+#include <linux/delay.h>
+#include <linux/gpio/consumer.h>
+#include <linux/module.h>
+#include <linux/mutex.h>
+#include <linux/of.h>
+#include <linux/regulator/consumer.h>
+
+#include <video/mipi_display.h>
+
+#include <drm/drm_mipi_dsi.h>
+#include <drm/drm_modes.h>
+#include <drm/drm_panel.h>
+#include <drm/drm_probe_helper.h>
+
+/* Supplies in enable order: vddio (1.8 V, PM660 L11) first, then vci
+ * (3.0 V, fixed regulator). The vendor supply table lists exactly these two;
+ * the lab/ibb phandles on the display node are not required supplies and are
+ * deliberately not requested here.
+ */
+static const struct regulator_bulk_data ea8074_supplies[] = {
+	{ .supply = "vddio" },
+	{ .supply = "vci" },
+};
+
+/* vci is the only supply with delays: qcom,supply-post-on-sleep = 10 and
+ * qcom,supply-pre-off-sleep = 10. vddio has no delay on either side.
+ */
+#define EA8074_VCI_ON_DELAY_MS	10
+#define EA8074_VCI_OFF_DELAY_MS	10
+
+/* qcom,mdss-dsi-reset-sequence = <0 2>, <1 11>: raw physical levels, i.e.
+ * reset LOW for 2 ms then HIGH for 11 ms. reset-gpios is GPIO_ACTIVE_LOW, so
+ * the logical values below produce exactly that waveform.
+ */
+#define EA8074_RESET_ASSERT_MS	2
+#define EA8074_RESET_RELEASE_MS	11
+
+/* Backlight range. The panel takes an unsigned 10-bit level and the vendor
+ * device tree agrees on the bounds (qcom,mdss-dsi-bl-min-level = <1>,
+ * qcom,mdss-dsi-bl-max-level = <1023>, qcom,mdss-brightness-max-level = <1023>).
+ * The backlight class only requires 0 <= brightness <= max_brightness, so:
+ *   0        = panel off (blank); 0x51 00 00 is what the vendor's own
+ *              on-command array writes during initialisation.
+ *   1..1023  = a real, valid brightness level.
+ * max_brightness is the panel's own maximum (1023), not the mainline
+ * backlight default of 2047.
+ */
+#define EA8074_BRIGHTNESS_MAX	1023
+
+struct ea8074 {
+	struct drm_panel panel;
+	struct mipi_dsi_device *dsi;
+	struct gpio_desc *reset_gpio;
+	struct regulator_bulk_data *supplies;
+	/*
+	 * Serialises the LP/HS windows: every sequence that depends on
+	 * dsi->mode_flags (the LP on/off command tables and the HS brightness
+	 * write) holds this while it sends, so a backlight update can never run
+	 * with the flag half-cleared during a prepare/disable sequence.
+	 */
+	struct mutex xfer_lock;
+};
+
+static inline struct ea8074 *to_ea8074(struct drm_panel *panel)
+{
+	return container_of(panel, struct ea8074, panel);
+}
+
+static void ea8074_reset(struct ea8074 *ctx)
+{
+	/* logical 1 == physical LOW == reset asserted */
+	gpiod_set_value_cansleep(ctx->reset_gpio, 1);
+	msleep(EA8074_RESET_ASSERT_MS);
+
+	/* logical 0 == physical HIGH == reset released */
+	gpiod_set_value_cansleep(ctx->reset_gpio, 0);
+	msleep(EA8074_RESET_RELEASE_MS);
+}
+
+static int ea8074_on(struct ea8074 *ctx)
+{
+	struct mipi_dsi_device *dsi = ctx->dsi;
+	struct mipi_dsi_multi_context dsi_ctx = { .dsi = dsi };
+
+	/* qcom,mdss-dsi-on-command: 204 bytes, 21 records, byte-for-byte the
+	 * vendor array. Neither the number of records nor their order may be
+	 * trimmed: record 17 (byte offset 167 of the array) is the pinned
+	 * zero-brightness write 0x51 00 00 and stays where the vendor put it.
+	 *
+	 * The array carries only two waits, 10 ms after sleep out and 110 ms
+	 * before display on, for 120 ms in total; every other record has
+	 * wait = 0.
+	 *
+	 * Transmission state: the downstream device tree gives this array
+	 *     qcom,mdss-dsi-on-command-state = "dsi_lp_mode";
+	 * (dsi-panel-ss-fhd-ea8074-cmd.dtsi L137) and downstream turns that
+	 * into a per-message MIPI_DSI_MSG_USE_LPM flag right before each
+	 * transfer (dsi_panel.c L761-763). Mainline reaches the same result
+	 * through the DSI device flag: mipi_dsi_device_transfer() ORs
+	 * MIPI_DSI_MSG_USE_LPM whenever dsi->mode_flags has MIPI_DSI_MODE_LPM
+	 * (drivers/gpu/drm/drm_mipi_dsi.c L448-460) and the msm host then
+	 * leaves the TX power mode in LP for that transfer (dsi_host.c
+	 * L2178/L2200). The flag is set for the whole life of this device in
+	 * probe(), and this sequence holds xfer_lock for the same reason the
+	 * brightness path does: it must not run interleaved with the HS window.
+	 */
+	mutex_lock(&ctx->xfer_lock);
+
+	/* record 0: 0x11 sleep out; vendor dtype 0x05, dlen 2, pad 0x00
+	 * dropped -> one-byte short write. Then the pinned 10 ms wait.
+	 */
+	mipi_dsi_dcs_exit_sleep_mode_multi(&dsi_ctx);
+	mipi_dsi_msleep(&dsi_ctx, 10);
+
+	/* record 1: 0x2b <00 00 08 c3> */
+	mipi_dsi_dcs_write_seq_multi(&dsi_ctx, 0x2b, 0x00, 0x00, 0x08, 0xc3);
+	/* record 2: 0xf0 <5a 5a> */
+	mipi_dsi_dcs_write_seq_multi(&dsi_ctx, 0xf0, 0x5a, 0x5a);
+	/* record 3: 0xef <f0 31 00 33 31 14 35> */
+	mipi_dsi_dcs_write_seq_multi(&dsi_ctx, 0xef, 0xf0, 0x31, 0x00, 0x33,
+				     0x31, 0x14, 0x35);
+	/* record 4: 0xb0 <01> */
+	mipi_dsi_dcs_write_seq_multi(&dsi_ctx, 0xb0, 0x01);
+	/* record 5: 0xbb <03> */
+	mipi_dsi_dcs_write_seq_multi(&dsi_ctx, 0xbb, 0x03);
+	/* record 6: 0xb0 <4f> */
+	mipi_dsi_dcs_write_seq_multi(&dsi_ctx, 0xb0, 0x4f);
+	/* record 7: 0xcb <00> */
+	mipi_dsi_dcs_write_seq_multi(&dsi_ctx, 0xcb, 0x00);
+	/* record 8: 0xb0 <6b> */
+	mipi_dsi_dcs_write_seq_multi(&dsi_ctx, 0xb0, 0x6b);
+	/* record 9: 0xcb <00> */
+	mipi_dsi_dcs_write_seq_multi(&dsi_ctx, 0xcb, 0x00);
+	/* record 10: 0xf7 <03> */
+	mipi_dsi_dcs_write_seq_multi(&dsi_ctx, 0xf7, 0x03);
+	/* record 11: 0xb0 <02> */
+	mipi_dsi_dcs_write_seq_multi(&dsi_ctx, 0xb0, 0x02);
+	/* record 12: 0xd5 <02 17 54 14> */
+	mipi_dsi_dcs_write_seq_multi(&dsi_ctx, 0xd5, 0x02, 0x17, 0x54, 0x14);
+	/* record 13: 0xb0 <05> */
+	mipi_dsi_dcs_write_seq_multi(&dsi_ctx, 0xb0, 0x05);
+	/* record 14: 0xb1 <10> */
+	mipi_dsi_dcs_write_seq_multi(&dsi_ctx, 0xb1, 0x10);
+	/* record 15: 0xf0 <a5 a5> */
+	mipi_dsi_dcs_write_seq_multi(&dsi_ctx, 0xf0, 0xa5, 0xa5);
+	/* record 16: 0x35 <00> tear on, mode 0 = V-Blanking only
+	 * (MIPI_DSI_DCS_TEAR_MODE_VBLANK)
+	 */
+	mipi_dsi_dcs_write_seq_multi(&dsi_ctx, 0x35, 0x00);
+
+	/* record 17: 0x51 <00 00>, the pinned zero-brightness initialisation.
+	 * Brightness updates after this point go through the backlight device,
+	 * which uses mipi_dsi_dcs_set_display_brightness_large() so that the
+	 * wire payload is [MSB, LSB]. Do not add a byte swap here: the fixture
+	 * derives the MSB-first order precisely because the vendor's
+	 * qcom,mdss-dsi-bl-inverted-dbv swap cancels against the vendor
+	 * helper's little-endian packing.
+	 */
+	mipi_dsi_dcs_write_seq_multi(&dsi_ctx, 0x51, 0x00, 0x00);
+
+	/* record 18: 0x53 <20> write control display */
+	mipi_dsi_dcs_write_seq_multi(&dsi_ctx, 0x53, 0x20);
+	/* record 19: 0x55 <00>, then the pinned 110 ms wait */
+	mipi_dsi_dcs_write_seq_multi(&dsi_ctx, 0x55, 0x00);
+	mipi_dsi_msleep(&dsi_ctx, 110);
+
+	/* record 20: 0x29 display on; vendor dtype 0x05, dlen 2, pad 0x00
+	 * dropped -> one-byte short write.
+	 */
+	mipi_dsi_dcs_set_display_on_multi(&dsi_ctx);
+
+	mutex_unlock(&ctx->xfer_lock);
+
+	return dsi_ctx.accum_err;
+}
+
+/* qcom,mdss-dsi-off-command record 0: 0x28 display off, then 37 ms.
+ * The downstream device tree gives the whole off array state "dsi_lp_mode"
+ * (dsi-panel-ss-fhd-ea8074-cmd.dtsi L138), so both of its records are LP; the
+ * flag is already set device-wide and the lock only keeps the HS brightness
+ * window from interleaving. The accumulated error is returned so the caller
+ * can log it; the callers deliberately do not fail the DRM panel state machine
+ * over it.
+ */
+static int ea8074_off_display(struct ea8074 *ctx)
+{
+	struct mipi_dsi_multi_context dsi_ctx = { .dsi = ctx->dsi };
+	int ret;
+
+	mutex_lock(&ctx->xfer_lock);
+	mipi_dsi_dcs_set_display_off_multi(&dsi_ctx);
+	mipi_dsi_msleep(&dsi_ctx, 37);
+	mutex_unlock(&ctx->xfer_lock);
+
+	ret = dsi_ctx.accum_err;
+
+	return ret;
+}
+
+/* qcom,mdss-dsi-off-command record 1: 0x10 enter sleep mode, then 121 ms.
+ * Also LP, per the same off-array state property as above.
+ */
+static int ea8074_sleep_in(struct ea8074 *ctx)
+{
+	struct mipi_dsi_multi_context dsi_ctx = { .dsi = ctx->dsi };
+	int ret;
+
+	mutex_lock(&ctx->xfer_lock);
+	mipi_dsi_dcs_enter_sleep_mode_multi(&dsi_ctx);
+	mipi_dsi_msleep(&dsi_ctx, 121);
+	mutex_unlock(&ctx->xfer_lock);
+
+	ret = dsi_ctx.accum_err;
+
+	return ret;
+}
+
+static int ea8074_prepare(struct drm_panel *panel)
+{
+	struct ea8074 *ctx = to_ea8074(panel);
+	struct device *dev = &ctx->dsi->dev;
+	int ret;
+
+	/*
+	 * Ordering: this panel is brought up in LP-11. The vendor device tree
+	 * sets qcom,mdss-dsi-lp11-init (dsi-panel-ss-fhd-ea8074-cmd.dtsi L36),
+	 * and downstream moves the power-on point when that property is
+	 * present: dsi_panel_pre_prepare() skips powering the panel and says so
+	 * ("If LP11_INIT is set, panel will be powered up during prepare()",
+	 * dsi_panel.c L4150-4152), while dsi_panel_prepare() powers it on
+	 * (dsi_panel.c L4326-4333). In mainline terms the panel must be
+	 * prepared after the DSI host is up, which is what
+	 * panel.prepare_prev_first = true in probe() expresses; there is no
+	 * separate mainline property for it.
+	 *
+	 * Stage 1: supplies. regulator_bulk_enable() unwinds its own partial
+	 * enables on failure, so nothing has to be undone if it fails.
+	 */
+	ret = regulator_bulk_enable(ARRAY_SIZE(ea8074_supplies), ctx->supplies);
+	if (ret) {
+		dev_err(dev, "failed to enable vddio/vci: %d\n", ret);
+		return ret;
+	}
+
+	/* Stage 2: vci post-on delay, then the pinned reset waveform. The
+	 * vendor table enables vddio with no delay and vci with a 10 ms
+	 * post-on delay, so one sleep after the bulk enable reproduces it.
+	 */
+	msleep(EA8074_VCI_ON_DELAY_MS);
+	ea8074_reset(ctx);
+
+	/* Stage 3: the on-command sequence. */
+	ret = ea8074_on(ctx);
+	if (ret) {
+		dev_err(dev, "on-command sequence failed: %d\n", ret);
+
+		/*
+		 * Roll the previous stages back in reverse order: put the panel
+		 * back into reset (physical LOW) and drop the supplies
+		 * (regulator_bulk_disable() walks the table backwards, so vci
+		 * goes down before vddio). The DRM panel core keeps
+		 * panel->prepared == false because this callback failed, so it
+		 * will not call unprepare() and never double-disables the
+		 * supplies: the enable/disable counts stay balanced.
+		 */
+		gpiod_set_value_cansleep(ctx->reset_gpio, 1);
+		regulator_bulk_disable(ARRAY_SIZE(ea8074_supplies),
+				       ctx->supplies);
+		return ret;
+	}
+
+	return 0;
+}
+
+static int ea8074_unprepare(struct drm_panel *panel)
+{
+	struct ea8074 *ctx = to_ea8074(panel);
+	struct device *dev = &ctx->dsi->dev;
+	int ret;
+
+	/* Record 1 of the off array: sleep in, 121 ms. */
+	ret = ea8074_sleep_in(ctx);
+	if (ret)
+		dev_err(dev, "failed to enter sleep mode: %d\n", ret);
+
+	/* Assert reset (physical LOW) before removing the supplies. */
+	gpiod_set_value_cansleep(ctx->reset_gpio, 1);
+
+	/*
+	 * The vendor disable order is: vci pre-off delay (10 ms), vci off,
+	 * vddio off. regulator_bulk_disable() disables in the reverse of the
+	 * table order (vci first), so the 10 ms has to be taken here, before
+	 * it.
+	 */
+	msleep(EA8074_VCI_OFF_DELAY_MS);
+	regulator_bulk_disable(ARRAY_SIZE(ea8074_supplies), ctx->supplies);
+
+	/*
+	 * The physical state is now "unprepared" either way, and the DRM panel
+	 * core only clears panel->prepared when this callback succeeds. A
+	 * failed DCS write is reported above but must not leave the core
+	 * believing the panel is still prepared, so the error is not
+	 * propagated.
+	 */
+	return 0;
+}
+
+static int ea8074_disable(struct drm_panel *panel)
+{
+	struct ea8074 *ctx = to_ea8074(panel);
+	int ret;
+
+	/* Record 0 of the off array: display off, 37 ms. The backlight has
+	 * already been turned off by the DRM panel core before this callback.
+	 * For the same state-machine reason as in unprepare() the error is
+	 * reported but not propagated.
+	 */
+	ret = ea8074_off_display(ctx);
+	if (ret)
+		dev_err(&ctx->dsi->dev, "failed to turn the display off: %d\n",
+			ret);
+
+	return 0;
+}
+
+static int ea8074_enable(struct drm_panel *panel)
+{
+	/*
+	 * Nothing to do: the panel is already scanning after the on-command
+	 * sequence in prepare(), and the DRM panel core enables the backlight
+	 * itself once this callback returns. Brightness therefore stays at the
+	 * pinned zero-brightness level until userspace asks for more.
+	 */
+	return 0;
+}
+
+static const struct drm_display_mode ea8074_mode = {
+	/* 1080x2244 @ 60 Hz, hfp 48 / hsw 16 / hbp 48,
+	 * vfp 28 / vsw 12 / vbp 28.
+	 */
+	.clock = (1080 + 48 + 16 + 48) * (2244 + 28 + 12 + 28) * 60 / 1000,
+	.hdisplay = 1080,
+	.hsync_start = 1080 + 48,
+	.hsync_end = 1080 + 48 + 16,
+	.htotal = 1080 + 48 + 16 + 48,
+	.vdisplay = 2244,
+	.vsync_start = 2244 + 28,
+	.vsync_end = 2244 + 28 + 12,
+	.vtotal = 2244 + 28 + 12 + 28,
+	/* qcom,mdss-pan-physical-width-dimension = <65>;
+	 * qcom,mdss-pan-physical-height-dimension = <135>
+	 */
+	.width_mm = 65,
+	.height_mm = 135,
+	.type = DRM_MODE_TYPE_DRIVER,
+};
+
+static int ea8074_get_modes(struct drm_panel *panel,
+			    struct drm_connector *connector)
+{
+	return drm_connector_helper_get_modes_fixed(connector, &ea8074_mode);
+}
+
+static const struct drm_panel_funcs ea8074_panel_funcs = {
+	.prepare = ea8074_prepare,
+	.enable = ea8074_enable,
+	.disable = ea8074_disable,
+	.unprepare = ea8074_unprepare,
+	.get_modes = ea8074_get_modes,
+};
+
+static int ea8074_bl_update_status(struct backlight_device *bl)
+{
+	struct ea8074 *ctx = bl_get_data(bl);
+	struct mipi_dsi_device *dsi = ctx->dsi;
+	u16 brightness = backlight_get_brightness(bl);
+	unsigned long saved_flags = dsi->mode_flags;
+	int ret;
+
+	/*
+	 * DCS 0x51 with the most significant byte first. The "large" helper
+	 * packs { brightness >> 8, brightness & 0xff }, which is exactly the
+	 * order the fixture derives for this panel, so no byte swap may be
+	 * added on top. The level is a plain 0..1023 value here: 0 blanks the
+	 * panel, 1..1023 are real levels, and both are legal for the backlight
+	 * class (max_brightness is the panel's own 1023).
+	 *
+	 * Transmission state: HS, not LP. The vendor does not send brightness
+	 * through a command set, so none of the "-command-state" properties
+	 * applies to it; it goes through the plain DCS helper from
+	 * dsi_panel_update_backlight() (dsi_panel.c L866-885), and the
+	 * downstream core can only add MIPI_DSI_MSG_USE_LPM when
+	 * dsi->mode_flags already has MIPI_DSI_MODE_LPM
+	 * (downstream drm_mipi_dsi.c L355-364) - and nothing in downstream ever
+	 * sets that flag (no assignment of MIPI_DSI_MODE_LPM anywhere in
+	 * dsi_panel.c or dsi_display.c). The brightness writes are therefore
+	 * HS on the real device, which is also how the same tree's sibling
+	 * panel expresses it in mainline (panel-samsung-ams639rq08.c L201-216
+	 * clears MIPI_DSI_MODE_LPM around its brightness write). The same
+	 * levers exist in this kernel: mipi_dsi_device_transfer() is the only
+	 * consumer of MIPI_DSI_MODE_LPM (drm_mipi_dsi.c L448-460) and the msm
+	 * host switches to HS only when MIPI_DSI_MSG_USE_LPM is absent
+	 * (dsi_host.c L2178/L2200).
+	 *
+	 * The flag is saved and restored, including on the error path, so a
+	 * failed write cannot leave the device stuck in HS for the following
+	 * command sequences, and the whole window is serialised against those
+	 * sequences by xfer_lock.
+	 */
+	mutex_lock(&ctx->xfer_lock);
+	dsi->mode_flags &= ~MIPI_DSI_MODE_LPM;
+	ret = mipi_dsi_dcs_set_display_brightness_large(dsi, brightness);
+	dsi->mode_flags = saved_flags;
+	mutex_unlock(&ctx->xfer_lock);
+
+	return ret;
+}
+
+static int ea8074_bl_get_brightness(struct backlight_device *bl)
+{
+	/* The requested level is authoritative here; no DCS read-back is
+	 * issued because the panel has nothing to report before its first
+	 * frame.
+	 */
+	return backlight_get_brightness(bl);
+}
+
+static const struct backlight_ops ea8074_bl_ops = {
+	.update_status = ea8074_bl_update_status,
+	.get_brightness = ea8074_bl_get_brightness,
+};
+
+static struct backlight_device *ea8074_create_backlight(struct ea8074 *ctx)
+{
+	struct device *dev = &ctx->dsi->dev;
+	/*
+	 * Start at 0: the pinned on-command array already sets brightness 0,
+	 * and the vendor defers the first non-zero backlight write until the
+	 * first frame has been committed (qcom,bl-update-flag =
+	 * "delay_until_first_frame"). Level 0 does not light anything up and is
+	 * the vendor's own initialisation value, so the driver never turns the
+	 * panel on by itself. For the first hardware test a conservative
+	 * ordinary level should be written once the first frame is up, e.g.
+	 *     echo 10 > /sys/class/backlight/*/brightness
+	 * 10 is a bring-up test choice for this run, not this panel's
+	 * default and not its doze level: the doze LBM/HBM values are 10/133
+	 * (dtsi L69-70) and are not used here, and no initial brightness is
+	 * parsed from the vendor device tree in the first place.
+	 *
+	 * The backlight devdata is the driver context, not the DSI device, so
+	 * update_status() can reach xfer_lock.
+	 */
+	const struct backlight_properties props = {
+		.type = BACKLIGHT_RAW,
+		.max_brightness = EA8074_BRIGHTNESS_MAX,
+		.brightness = 0,
+	};
+
+	return devm_backlight_device_register(dev, dev_name(dev), dev, ctx,
+					      &ea8074_bl_ops, &props);
+}
+
+static int ea8074_probe(struct mipi_dsi_device *dsi)
+{
+	struct device *dev = &dsi->dev;
+	struct ea8074 *ctx;
+	int ret;
+
+	ctx = devm_drm_panel_alloc(dev, struct ea8074, panel,
+				   &ea8074_panel_funcs, DRM_MODE_CONNECTOR_DSI);
+	if (IS_ERR(ctx))
+		return PTR_ERR(ctx);
+
+	ret = devm_regulator_bulk_get_const(dev, ARRAY_SIZE(ea8074_supplies),
+					    ea8074_supplies, &ctx->supplies);
+	if (ret)
+		return dev_err_probe(dev, ret, "failed to get vddio/vci\n");
+
+	/*
+	 * GPIOD_OUT_HIGH asserts the active-low reset, so the panel is held in
+	 * reset after probe until prepare() runs. Claiming the reset line and
+	 * the supplies also takes the panel over from the bootloader: whatever
+	 * the bootloader left on screen is not preserved. That is acceptable
+	 * only for a temporarily booted test kernel (fastboot boot); this
+	 * driver never writes to flash.
+	 */
+	ctx->reset_gpio = devm_gpiod_get(dev, "reset", GPIOD_OUT_HIGH);
+	if (IS_ERR(ctx->reset_gpio))
+		return dev_err_probe(dev, PTR_ERR(ctx->reset_gpio),
+				     "failed to get reset-gpios\n");
+
+	ctx->dsi = dsi;
+	mipi_dsi_set_drvdata(dsi, ctx);
+
+	dsi->lanes = 4;
+	dsi->format = MIPI_DSI_FMT_RGB888;
+	/*
+	 * Command mode: qcom,mdss-dsi-panel-type is "dsi_cmd_mode" (downstream
+	 * dtsi L25), so no MIPI_DSI_MODE_VIDEO* flag is set.
+	 *
+	 * MIPI_DSI_MODE_LPM is the default state of this device because the
+	 * vendor sends both command arrays in LP: the device tree marks the on
+	 * and off arrays "dsi_lp_mode" (dtsi L137, L138) and downstream turns
+	 * that into MIPI_DSI_MSG_USE_LPM per message (dsi_panel.c L761-763).
+	 * The brightness write is the one exception; ea8074_bl_update_status()
+	 * clears this flag for the duration of that transfer because the
+	 * vendor sends it without LP.
+	 *
+	 * MIPI_DSI_CLOCK_NON_CONTINUOUS is the clock-lane behaviour of this
+	 * panel's command-mode host configuration; it is the flag the pinned
+	 * tree's own command-mode panel for the same SoC uses as well.
+	 */
+	dsi->mode_flags = MIPI_DSI_CLOCK_NON_CONTINUOUS | MIPI_DSI_MODE_LPM;
+
+	/*
+	 * qcom,mdss-dsi-lp11-init (dtsi L36) means the panel is initialised in
+	 * LP-11: downstream therefore powers the panel on during prepare()
+	 * rather than earlier (dsi_panel.c L4149-4153) and only after the DSI
+	 * host is up (dsi_panel_enable(), dsi_panel.c L4322-4331). Mainline
+	 * expresses the same requirement for a DSI panel with
+	 * prepare_prev_first, so the host is enabled before this driver's
+	 * prepare() callback runs.
+	 */
+	ctx->panel.prepare_prev_first = true;
+
+	/*
+	 * xfer_lock serialises the LP command sequences against the HS
+	 * brightness window (see ea8074_bl_update_status()).
+	 */
+	mutex_init(&ctx->xfer_lock);
+
+	ctx->panel.backlight = ea8074_create_backlight(ctx);
+	if (IS_ERR(ctx->panel.backlight))
+		return dev_err_probe(dev, PTR_ERR(ctx->panel.backlight),
+				     "failed to create backlight\n");
+
+	drm_panel_add(&ctx->panel);
+
+	ret = devm_mipi_dsi_attach(dev, dsi);
+	if (ret) {
+		drm_panel_remove(&ctx->panel);
+		return dev_err_probe(dev, ret, "failed to attach to DSI host\n");
+	}
+
+	return 0;
+}
+
+static void ea8074_remove(struct mipi_dsi_device *dsi)
+{
+	struct ea8074 *ctx = mipi_dsi_get_drvdata(dsi);
+
+	drm_panel_remove(&ctx->panel);
+}
+
+static void ea8074_shutdown(struct mipi_dsi_device *dsi)
+{
+	struct ea8074 *ctx = mipi_dsi_get_drvdata(dsi);
+	int ret;
+
+	/*
+	 * Do not call drm_panel_disable()/drm_panel_unprepare() here: the DRM
+	 * panel core owns the prepared/enabled state and tears the panel down
+	 * in its own shutdown path, so driving it a second time would only
+	 * produce "already unprepared" warnings. If the panel is nevertheless
+	 * still prepared at this point, put it back into sleep mode and assert
+	 * reset so that shutdown never leaves it scanning.
+	 */
+	if (!ctx->panel.prepared)
+		return;
+
+	ret = ea8074_sleep_in(ctx);
+	if (ret)
+		dev_err(&dsi->dev, "failed to enter sleep mode: %d\n", ret);
+
+	gpiod_set_value_cansleep(ctx->reset_gpio, 1);
+}
+
+static const struct of_device_id ea8074_of_match[] = {
+	{ .compatible = "samsung,ea8074" },
+	{ /* sentinel */ }
+};
+MODULE_DEVICE_TABLE(of, ea8074_of_match);
+
+static struct mipi_dsi_driver ea8074_driver = {
+	.probe = ea8074_probe,
+	.remove = ea8074_remove,
+	.shutdown = ea8074_shutdown,
+	.driver = {
+		.name = "panel-samsung-ea8074",
+		.of_match_table = ea8074_of_match,
+	},
+};
+module_mipi_dsi_driver(ea8074_driver);
+
+MODULE_DESCRIPTION("DRM driver for the Samsung EA8074 command mode DSI panel");
+MODULE_LICENSE("GPL");
