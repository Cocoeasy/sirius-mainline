+# SPDX-License-Identifier: GPL-2.0-only OR BSD-2-Clause
+%YAML 1.2
+---
+$id: http://devicetree.org/schemas/display/panel/samsung,ea8074.yaml#
+$schema: http://devicetree.org/meta-schemas/core.yaml#
+
+title: Samsung EA8074 5.88" 1080x2244 MIPI-DSI command mode AMOLED panel
+
+maintainers:
+  - Cocoeasy <Cocoeasy@users.noreply.github.com>
+
+description:
+  The Samsung EA8074 is a 5.88 inch 1080x2244 MIPI-DSI command mode AMOLED
+  panel with a built-in 10-bit DCS brightness control. It is found in the
+  Xiaomi Mi 8 SE (xiaomi-sirius, SDM710).
+
+allOf:
+  - $ref: panel-common.yaml#
+
+properties:
+  compatible:
+    const: samsung,ea8074
+
+  reg:
+    maxItems: 1
+
+  vddio-supply:
+    description: I/O source voltage rail (1.8 V)
+
+  vci-supply:
+    description: Source voltage rail (3.0 V)
+
+  reset-gpios: true
+  port: true
+
+required:
+  - compatible
+  - reg
+  - vddio-supply
+  - vci-supply
+  - reset-gpios
+  - port
+
+additionalProperties: false
+
+examples:
+  - |
+    #include <dt-bindings/gpio/gpio.h>
+
+    dsi {
+        #address-cells = <1>;
+        #size-cells = <0>;
+
+        panel@0 {
+            compatible = "samsung,ea8074";
+            reg = <0>;
+
+            vddio-supply = <&vreg_l11a_1p8>;
+            vci-supply = <&disp_vci_vreg>;
+
+            reset-gpios = <&tlmm 75 GPIO_ACTIVE_LOW>;
+
+            port {
+                panel_in: endpoint {
+                    remote-endpoint = <&mdss_dsi0_out>;
+                };
+            };
+        };
+    };
+
+...
