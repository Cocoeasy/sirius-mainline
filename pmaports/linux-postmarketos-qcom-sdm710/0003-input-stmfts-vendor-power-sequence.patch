From: sirius bring-up <sirius@local>
Subject: [PATCH] input: stmfts: assert reset through power-up like the vendor driver

The controller on this board is never reset by the current driver: stmfts.c
here has no reset GPIO handling at all (only the STMFTS_SYSTEM_RESET I2C
command), so power-on is just "enable supplies, sleep 20 ms, talk to the IC".

The vendor driver (fts_521/fts.c, fts_chip_powercycle) does the opposite
order: it asserts the reset, *then* brings the supplies up, waits, and only
afterwards releases the reset.  Without that, the controller comes up in an
uninitialised state, holds SCL low (clock stretching) and never answers: every
I2C transfer runs into the 1 s timeout and the GENI SE never reports
command-done, so the touchscreen never probes.

Obtain the reset GPIO (reset-gpios in the DT, declared GPIO_ACTIVE_LOW so
"asserted" means the pin is driven low) and reproduce the vendor sequence,
including the long power-up delay the datasheet leaves unspecified.

--- a/drivers/input/touchscreen/stmfts.c
+++ b/drivers/input/touchscreen/stmfts.c
@@ -7,6 +7,7 @@
 #include <linux/delay.h>
+#include <linux/gpio/consumer.h>
 #include <linux/i2c.h>
 #include <linux/input/mt.h>
 #include <linux/input/touchscreen.h>
@@ -83,6 +84,8 @@ struct stmfts_data {
 	struct touchscreen_properties prop;
 
 	struct regulator_bulk_data regulators[2];
+
+	struct gpio_desc *reset_gpio;
 
 	/*
 	 * Presence of ledvdd will be used also to check
@@ -525,16 +528,26 @@ static int stmfts_power_on(struct stmfts_data *sdata)
 {
 	int err;
 	u8 reg[8];
 
+	/*
+	 * Vendor sequence (fts_chip_powercycle): the controller has to see its
+	 * reset asserted while the supplies come up, and then needs a
+	 * substantial delay before it answers on I2C.
+	 */
+	if (sdata->reset_gpio)
+		gpiod_set_value_cansleep(sdata->reset_gpio, 1);
+
 	err = regulator_bulk_enable(ARRAY_SIZE(sdata->regulators),
 				    sdata->regulators);
 	if (err)
 		return err;
 
-	/*
-	 * The datasheet does not specify the power on time, but considering
-	 * that the reset time is < 10ms, I sleep 20ms to be sure
-	 */
-	msleep(20);
+	msleep(310);
+
+	if (sdata->reset_gpio)
+		gpiod_set_value_cansleep(sdata->reset_gpio, 0);
+
+	msleep(20);
 
 	err = i2c_smbus_read_i2c_block_data(sdata->client, STMFTS_READ_INFO,
 					    sizeof(reg), reg);
@@ -639,6 +652,12 @@ static int stmfts_probe(struct i2c_client *client)
 	err = devm_regulator_bulk_get(&client->dev,
 				      ARRAY_SIZE(sdata->regulators),
 				      sdata->regulators);
 	if (err)
 		return err;
 
+	sdata->reset_gpio = devm_gpiod_get_optional(&client->dev, "reset",
+						    GPIOD_OUT_HIGH);
+	if (IS_ERR(sdata->reset_gpio))
+		return PTR_ERR(sdata->reset_gpio);
+
 	sdata->input = devm_input_allocate_device(&client->dev);
 	if (!sdata->input)
 		return -ENOMEM;
-- 
