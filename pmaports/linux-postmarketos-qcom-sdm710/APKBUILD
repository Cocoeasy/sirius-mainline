# Reference: <https://postmarketos.org/devicepkg>
# Maintainer: Your Name <you@example.org>
#
# Reuses the sdm670-mainline kernel fork (which already contains
# sdm710.dtsi + sdm710-xiaomi-pyxis.dts) and injects the xiaomi-sirius
# device tree at build time.
_flavor="postmarketos-qcom-sdm710"
pkgname=linux-$_flavor
pkgver=7.1.3
pkgrel=0
pkgdesc="Mainline Kernel fork for SDM710 devices (Xiaomi Mi 8 SE)"
arch="aarch64"
_carch="arm64"
url="https://gitlab.com/sdm670-mainline/linux"
license="GPL-2.0-only"
options="!strip !check !tracedeps
	pmb:cross-native"
makedepends="
	bash
	bison
	findutils
	flex
	installkernel
	openssl-dev
	perl
	python3
	zstd
"

_tag="sdm670-v$pkgver"

source="
	https://gitlab.com/sdm670-mainline/linux/-/archive/$_tag/linux-$_tag.tar.gz
	sdm710-xiaomi-sirius.dts
	0001-dt-bindings-display-panel-samsung-ea8074.patch
	0002-drm-panel-samsung-ea8074.patch
"
builddir="$srcdir/linux-$_tag"

prepare() {
	default_prepare

	cp "$srcdir"/sdm710-xiaomi-sirius.dts arch/arm64/boot/dts/qcom/
	local mf=arch/arm64/boot/dts/qcom/Makefile
	grep -q 'sdm710-xiaomi-sirius.dtb' "$mf" || \
		printf 'dtb-$(CONFIG_ARCH_QCOM)\t+= sdm710-xiaomi-sirius.dtb\n' >> "$mf"

	make ARCH="$_carch" defconfig
	scripts/kconfig/merge_config.sh -m .config arch/arm64/configs/sdm670.config

	# The EA8074 panel driver and its binding arrive as patches (source= above,
	# applied by default_prepare). Two config symbols must then be forced on:
	# the panel's own symbol has no default, and BACKLIGHT_CLASS_DEVICE -- which
	# its Kconfig depends on -- is not set by either defconfig or sdm670.config,
	# so without both the driver would be silently dropped from the build.
	printf '%s\n' \
		'CONFIG_BACKLIGHT_CLASS_DEVICE=y' \
		'CONFIG_DRM_PANEL_SAMSUNG_EA8074=y' > "$srcdir"/ea8074.config
	scripts/kconfig/merge_config.sh -m .config "$srcdir"/ea8074.config

	make ARCH="$_carch" olddefconfig

	# Diagnose which dependency keeps the panel symbol from sticking.
	echo "--- ea8074 config state after olddefconfig ---"
	grep -E 'CONFIG_DRM_PANEL_SAMSUNG_EA8074|CONFIG_BACKLIGHT_CLASS_DEVICE|CONFIG_BACKLIGHT=|CONFIG_DRM_MIPI_DSI|^CONFIG_DRM=|^CONFIG_OF=|CONFIG_DRM_MSM' .config || true
	echo "--- end ---"

	# Fail loudly rather than shipping a kernel without the panel driver.
	for sym in CONFIG_DRM_PANEL_SAMSUNG_EA8074 CONFIG_BACKLIGHT_CLASS_DEVICE; do
		grep -q "^$sym=y" .config || {
			echo "FATAL: $sym did not stick in .config" >&2
			exit 1
		}
	done
}

build() {
	unset LDFLAGS
	make ARCH="$_carch" CC="${CC:-gcc}" -j"${JOBS:-$(nproc)}" \
		KBUILD_BUILD_VERSION="$((pkgrel + 1))-$_flavor" \
		Image.gz dtbs modules
}

package() {
	mkdir -p "$pkgdir"/boot

	install -Dm644 "$builddir/arch/$_carch/boot/Image.gz" \
		"$pkgdir/boot/vmlinuz"

	make modules_install dtbs_install \
		ARCH="$_carch" \
		INSTALL_PATH="$pkgdir"/boot/ \
		INSTALL_MOD_PATH="$pkgdir" \
		INSTALL_MOD_STRIP=1 \
		INSTALL_DTBS_PATH="$pkgdir"/boot/dtbs
	rm -f "$pkgdir"/lib/modules/*/build "$pkgdir"/lib/modules/*/source

	install -D "$builddir"/include/config/kernel.release \
		"$pkgdir"/usr/share/kernel/$_flavor/kernel.release
}
