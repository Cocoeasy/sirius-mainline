# Reference: <https://postmarketos.org/devicepkg>
# Maintainer: Your Name <you@example.org>
#
# Reuses the sdm670-mainline kernel fork (which already contains
# sdm710.dtsi + sdm710-xiaomi-pyxis.dts) and injects the xiaomi-sirius
# device tree at build time.
_flavor="postmarketos-qcom-sdm710"
pkgname=linux-$_flavor
pkgver=7.1.3
pkgrel=1
pkgdesc="Mainline Kernel fork for SDM710 devices (Xiaomi Mi 8 SE)"
arch="aarch64"
_carch="arm64"
url="https://gitlab.com/sdm670-mainline/linux"
license="GPL-2.0-only"
options="!strip !check !tracedeps
	pmb:cross-native"
makedepends="
	bash
	bison
	findutils
	flex
	installkernel
	openssl-dev
	perl
	python3
	zstd
"

_tag="sdm670-v$pkgver"

source="
	https://gitlab.com/sdm670-mainline/linux/-/archive/$_tag/linux-$_tag.tar.gz
	sdm710-xiaomi-sirius.dts
	0001-dt-bindings-display-panel-samsung-ea8074.patch
	0002-drm-panel-samsung-ea8074.patch
"
builddir="$srcdir/linux-$_tag"

prepare() {
	default_prepare

	cp "$srcdir"/sdm710-xiaomi-sirius.dts arch/arm64/boot/dts/qcom/
	local mf=arch/arm64/boot/dts/qcom/Makefile
	grep -q 'sdm710-xiaomi-sirius.dtb' "$mf" || \
		printf 'dtb-$(CONFIG_ARCH_QCOM)\t+= sdm710-xiaomi-sirius.dtb\n' >> "$mf"

	make ARCH="$_carch" defconfig
	scripts/kconfig/merge_config.sh -m .config arch/arm64/configs/sdm670.config

	# The EA8074 panel driver and its binding arrive as patches (source= above,
	# applied by default_prepare). Two config symbols must then be forced on:
	# the panel's own symbol has no default, and BACKLIGHT_CLASS_DEVICE -- which
	# its Kconfig depends on -- is not set by either defconfig or sdm670.config,
	# so without both the driver would be silently dropped from the build.
	# The panel resolves to =m rather than =y because DRM itself is =m here, so
	# the assertion below accepts either; the module is loaded early via the
	# device package's modules-initfs.
	#
	# Extra symbols on top of defconfig + sdm670.config. This mirrors
	# config/sirius.config (the fragment build.yml merges) so the pmOS image
	# gets the same storage / USB / touch / charger / WiFi / remoteproc /
	# console / pstore set -- but keeps the GPU, panel and touchscreen drivers
	# as MODULES, because the device package loads exactly those into the
	# initramfs through modules-initfs; building any of them in would leave that
	# list pointing at modules that no longer exist.
	#
	# CONFIG_PHY_QCOM_QUSB2 is the USB2 (high-speed) PHY paired with the dwc3
	# controller. It is NOT set by defconfig or sdm670.config, so the PHY node
	# in the DTS (phy@88e2000) gets no driver at all: /sys/class/phy stays
	# empty, dwc3 then fails with "failed to initialize core" and no UDC
	# appears -- i.e. no USB gadget. Force it on.
	#
	# Deliberately NOT set here: CONFIG_DRM_SIMPLEDRM / CONFIG_DRM_FBDEV_EMULATION
	# / CONFIG_FRAMEBUFFER_CONSOLE. config/sirius.config turns them on because the
	# bring-up boot.img has no UART and the panel is its only console -- but in a
	# phosh image they take the display away from the compositor:
	#   * simpledrm registers a second DRM card (card1 "Unknown-1", 285x593mm)
	#     next to msm's card0-DSI-1;
	#   * fbdev emulation creates fb0 on the msm CRTC.
	# phoc then cannot commit: "connector DSI-1: Atomic commit failed: Resource
	# busy", and with two cards the greeter dies with "Error 71 (Protocol error)
	# dispatching to Wayland display" -> greetd start-limit-hit -> no UI.
	# Verified on the device: unbinding simple-framebuffer clears Error 71.
	printf '%s\n' \
		'CONFIG_BACKLIGHT_CLASS_DEVICE=y' \
		'CONFIG_DRM_PANEL_SAMSUNG_EA8074=m' \
		'CONFIG_DRM_MSM_GPU_STATE=y' \
		'CONFIG_PHY_QCOM_QUSB2=y' \
		'CONFIG_TOUCHSCREEN_STMFTS=m' \
		'CONFIG_SCSI_UFS_QCOM=y' \
		'CONFIG_PHY_QCOM_QMP=y' \
		'CONFIG_PHY_QCOM_QMP_UFS=y' \
		'CONFIG_PHY_QCOM_QMP_COMBO=n' \
		'CONFIG_PHY_QCOM_QMP_PCIE=n' \
		'CONFIG_PHY_QCOM_QMP_PCIE_8996=n' \
		'CONFIG_PHY_QCOM_QMP_USB=n' \
		'CONFIG_PHY_QCOM_QMP_USB_LEGACY=n' \
		'CONFIG_USB_DWC3_DUAL_ROLE=y' \
		'CONFIG_EXTCON=y' \
		'CONFIG_EXTCON_USB_GPIO=y' \
		'CONFIG_NVMEM=y' \
		'CONFIG_NVMEM_QCOM_QFPROM=y' \
		'CONFIG_USB_GADGET=y' \
		'CONFIG_USB_CONFIGFS=y' \
		'CONFIG_USB_CONFIGFS_ACM=y' \
		'CONFIG_USB_CONFIGFS_NCM=y' \
		'CONFIG_USB_CONFIGFS_RNDIS=y' \
		'CONFIG_USB_CONFIGFS_ECM=y' \
		'CONFIG_USB_CONFIGFS_F_FS=y' \
		'CONFIG_QCOM_AOSS_QMP=y' \
		'CONFIG_QCOM_COMMAND_DB=y' \
		'CONFIG_QCOM_LLCC=y' \
		'CONFIG_QCOM_OCMEM=n' \
		'CONFIG_BATTERY_QCOM_FG=m' \
		'CONFIG_CHARGER_QCOM_SMB2=m' \
		'CONFIG_QCOM_SPMI_RRADC=m' \
		'CONFIG_INPUT_QCOM_SPMI_HAPTICS=m' \
		'CONFIG_ATH10K=m' \
		'CONFIG_ATH10K_SNOC=m' \
		'CONFIG_QCOM_QMI_HELPERS=y' \
		'CONFIG_QCOM_Q6V5_PAS=y' \
		'CONFIG_QCOM_Q6V5_MSS=y' \
		'CONFIG_QCOM_PD_MAPPER=m' \
		'CONFIG_QCOM_RMTFS_MEM=y' \
		'CONFIG_SERIAL_QCOM_GENI=y' \
		'CONFIG_SERIAL_QCOM_GENI_CONSOLE=y' \
		'CONFIG_VT=y' \
		'CONFIG_LOGO=n' \
		'CONFIG_PSTORE=y' \
		'CONFIG_PSTORE_DEFAULT_KMSG_BYTES=10240' \
		'CONFIG_PSTORE_CONSOLE=y' \
		'CONFIG_PSTORE_PMSG=y' \
		'CONFIG_PSTORE_RAM=y' \
		'CONFIG_PSTORE_FTRACE=y' \
		> "$srcdir"/bringup.config
	scripts/kconfig/merge_config.sh -m .config "$srcdir"/bringup.config

	make ARCH="$_carch" olddefconfig

	# Fail loudly rather than shipping a kernel without the panel driver. The
	# symbol is a tristate, so =m is as valid as =y.
	grep -qE '^CONFIG_DRM_PANEL_SAMSUNG_EA8074=[ym]$' .config || {
		echo "FATAL: CONFIG_DRM_PANEL_SAMSUNG_EA8074 is not enabled in .config" >&2
		grep -E 'CONFIG_DRM_PANEL_SAMSUNG_EA8074|CONFIG_BACKLIGHT_CLASS_DEVICE|CONFIG_DRM_MIPI_DSI|^CONFIG_DRM=' .config >&2 || true
		exit 1
	}
	grep -qE '^CONFIG_BACKLIGHT_CLASS_DEVICE=[ym]$' .config || {
		echo "FATAL: CONFIG_BACKLIGHT_CLASS_DEVICE is not enabled in .config" >&2
		exit 1
	}
	# Without the USB2 PHY driver the dwc3 controller cannot come up and there
	# is no USB gadget (see above).
	grep -qE '^CONFIG_PHY_QCOM_QUSB2=[ym]$' .config || {
		echo "FATAL: CONFIG_PHY_QCOM_QUSB2 is not enabled in .config" >&2
		grep -E 'CONFIG_PHY_QCOM' .config >&2 || true
		exit 1
	}
	# The STMFTS touchscreen (DT node "st,stmfts" on i2c@a84000) has to be in the
	# image too: without it the panel lights up but the screen is not touchable.
	# tristate, so =m is as valid as =y (Kconfig caps it at the I2C value).
	grep -qE '^CONFIG_TOUCHSCREEN_STMFTS=[ym]$' .config || {
		echo "FATAL: CONFIG_TOUCHSCREEN_STMFTS is not enabled in .config" >&2
		grep -E 'CONFIG_TOUCHSCREEN|CONFIG_I2C|CONFIG_LEDS_CLASS|CONFIG_NEW_LEDS' .config >&2 || true
		exit 1
	}
}

build() {
	unset LDFLAGS
	make ARCH="$_carch" CC="${CC:-gcc}" -j"${JOBS:-$(nproc)}" \
		KBUILD_BUILD_VERSION="$((pkgrel + 1))-$_flavor" \
		Image.gz dtbs modules
}

package() {
	mkdir -p "$pkgdir"/boot

	install -Dm644 "$builddir/arch/$_carch/boot/Image.gz" \
		"$pkgdir/boot/vmlinuz"

	make modules_install dtbs_install \
		ARCH="$_carch" \
		INSTALL_PATH="$pkgdir"/boot/ \
		INSTALL_MOD_PATH="$pkgdir" \
		INSTALL_MOD_STRIP=1 \
		INSTALL_DTBS_PATH="$pkgdir"/boot/dtbs
	rm -f "$pkgdir"/lib/modules/*/build "$pkgdir"/lib/modules/*/source

	install -D "$builddir"/include/config/kernel.release \
		"$pkgdir"/usr/share/kernel/$_flavor/kernel.release
}
