# Reference: <https://postmarketos.org/devicepkg>
#
# Device-specific GPU zap shader for the Xiaomi Mi 8 SE (xiaomi-sirius).
#
# The GPU on this board is an Adreno 615 (the device tree reports
# qcom,adreno-615.0 and the stock vendor image ships a615_zap.*), so the zap
# shader is a615_zap, not a630_zap.
#
# The zap shader is signed and therefore device-specific, which is why
# firmware-qcom-adreno deliberately strips every *_zap* file and why
# linux-firmware does not carry a615_zap.mbn. This package supplies the
# missing half: the five files were extracted read-only from this device's own
# stock vendor image
# (sirius_images_V9.5.6.0.OEBCNFA_20180605.0000.00_8.1_cn/images/vendor.img,
# firmware/a615_zap.{mdt,b00,b01,b02,elf}), so they are the ones this unit is
# provisioned with.
#
# The generic a630_gmu.bin and a630_sqe.fw come from firmware-qcom-adreno-a630
# and are NOT duplicated here.
pkgname=firmware-xiaomi-sirius
pkgver=1
pkgrel=1
pkgdesc="GPU zap shader firmware for the Xiaomi Mi 8 SE"
url="https://postmarketos.org"
arch="aarch64"
license="custom"
options="!check !strip !archcheck !tracedeps"

source="
	a615_zap.mdt
	a615_zap.b00
	a615_zap.b01
	a615_zap.b02
	a615_zap.elf
"

package() {
	# Same location the kernel requests from: dmesg shows
	# "Direct firmware load for qcom/a630_sqe.fw", i.e. /usr/lib/firmware/qcom/.
	install -Dm644 "$srcdir"/a615_zap.* -t "$pkgdir"/usr/lib/firmware/qcom/

	# The generic qcom/ path above is NOT where the zap shader is looked up.
	# msm resolves it as qcom/<soc>/<device>/<name>.mbn, and dmesg says exactly
	#   "adreno_zap_shader_load: Unable to load qcom/sdm710/sirius/a615_zap.mbn"
	# -> "adreno_load_gpu: gpu hw init failed: -2"
	# -> phoc has no EGL renderer -> greetd start-limit-hit -> black screen.
	# a615_zap.elf is the complete single-file image (its ELF program headers
	# resolve inside its 14240 bytes; the .mdt/.bNN split files are a partial
	# prefix plus segments), so ship it under the name the kernel asks for.
	install -Dm644 "$srcdir"/a615_zap.elf \
		"$pkgdir"/usr/lib/firmware/qcom/sdm710/sirius/a615_zap.mbn
}

