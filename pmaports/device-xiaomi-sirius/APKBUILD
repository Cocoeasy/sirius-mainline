# Reference: <https://postmarketos.org/devicepkg>
# Maintainer: Your Name <you@example.org>
pkgname=device-xiaomi-sirius
pkgdesc="Xiaomi Mi 8 SE"
pkgver=1
pkgrel=0
url="https://postmarketos.org"
license="MIT"
arch="aarch64"
options="!check !archcheck"
depends="
	linux-postmarketos-qcom-sdm710
	mkbootimg
	postmarketos-base
	firmware-qcom-adreno-a630
	firmware-xiaomi-sirius
"
makedepends="devicepkg-dev"
source="
	deviceinfo
	modules-initfs
	ea8074-backlight.sh
	ea8074-backlight.service
	pmos-usb-gadget.sh
	pmos-usb-gadget.service
"

build() {
	devicepkg_build $startdir $pkgname
}

package() {
	devicepkg_package $startdir $pkgname

	# --- EA8074 panel backlight bring-up -----------------------------------
	# The panel driver registers the backlight at brightness 0 (the pinned
	# vendor on-sequence writes 0x51 00 00), so the panel stays dark until
	# userspace sets a level. Bring it up at boot from userspace; this keeps
	# the fix out of the kernel and out of the initramfs.
	install -Dm755 "$srcdir"/ea8074-backlight.sh \
		"$pkgdir"/usr/bin/ea8074-backlight
	install -Dm644 "$srcdir"/ea8074-backlight.service \
		"$pkgdir"/usr/lib/systemd/system/ea8074-backlight.service
	install -d "$pkgdir"/usr/lib/systemd/system/multi-user.target.wants
	ln -s ../ea8074-backlight.service \
		"$pkgdir"/usr/lib/systemd/system/multi-user.target.wants/ea8074-backlight.service

	# --- USB gadget (ACM serial + NCM network) -----------------------------
	# Give the host a COM port and a network interface to the device, so it
	# can be reached without a special bring-up image.
	install -Dm755 "$srcdir"/pmos-usb-gadget.sh \
		"$pkgdir"/usr/bin/pmos-usb-gadget
	install -Dm644 "$srcdir"/pmos-usb-gadget.service \
		"$pkgdir"/usr/lib/systemd/system/pmos-usb-gadget.service
	install -d "$pkgdir"/usr/lib/systemd/system/multi-user.target.wants
	ln -s ../pmos-usb-gadget.service \
		"$pkgdir"/usr/lib/systemd/system/multi-user.target.wants/pmos-usb-gadget.service
}
