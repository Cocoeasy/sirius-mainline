# Sirius (Xiaomi Mi 8 SE) bring-up config fragment.
# Merged on top of arch/arm64/configs/sdm670.config from sdm670-mainline/linux.

CONFIG_LOCALVERSION="-sirius"

# --- Storage: UFS rootfs + MicroSD ---
# PHY_QCOM_QMP is a menuconfig and everything under it is capped at the menu's
# value, so asking for PHY_QCOM_QMP_UFS=y alone is silently downgraded to =m
# while the menu stays =m (defconfig). Without the PHY the UFS host never
# probes: "ufshcd_pltfrm_init() failed", no /dev/sda, no rootfs.
CONFIG_SCSI_UFS_QCOM=y
CONFIG_PHY_QCOM_QMP=y
CONFIG_PHY_QCOM_QMP_UFS=y
# Not needed for bring-up; keep the image lean.
CONFIG_PHY_QCOM_QMP_COMBO=n
CONFIG_PHY_QCOM_QMP_PCIE=n
CONFIG_PHY_QCOM_QMP_PCIE_8996=n
CONFIG_PHY_QCOM_QMP_USB=n
CONFIG_PHY_QCOM_QMP_USB_LEGACY=n

# --- USB (debug lifeline: USB gadget network + serial) ---
# The QUSB2 HS PHY is =m in the arm64 defconfig. As a module it can never be
# loaded from our module-less initramfs, so usb_1_hsphy never probes, dwc3 has
# no PHY, no UDC appears and the RNDIS gadget is never created. Build the PHY
# (and the extcon chain the dwc3 node references) in instead.
CONFIG_PHY_QCOM_QUSB2=y
CONFIG_USB_DWC3_DUAL_ROLE=y
CONFIG_EXTCON=y
CONFIG_EXTCON_USB_GPIO=y
CONFIG_NVMEM=y
CONFIG_NVMEM_QCOM_QFPROM=y
CONFIG_USB_GADGET=y
CONFIG_USB_CONFIGFS=y
CONFIG_USB_CONFIGFS_RNDIS=y
CONFIG_USB_CONFIGFS_ECM=y
CONFIG_USB_CONFIGFS_F_FS=y

# --- Display: MSM DPU + DSI (10nm PHY) + Samsung EA8074 panel ---
# Every symbol here has to be built in: the initramfs carries no modules, so a
# =m display stack would leave the device with simpledrm only.
CONFIG_DRM=y
CONFIG_DRM_MSM=y
CONFIG_DRM_MSM_DPU=y
CONFIG_DRM_MSM_DSI=y
CONFIG_DRM_MSM_DSI_10NM_PHY=y
# Added by patches/linux/0001-drm-panel-samsung-ea8074.patch.
CONFIG_DRM_PANEL_SAMSUNG_EA8074=y
# The panel driver's Kconfig entry is
#   "tristate ...; depends on OF; depends on DRM_MIPI_DSI;
#    depends on BACKLIGHT_CLASS_DEVICE"
# and in the pinned tree BACKLIGHT_CLASS_DEVICE is a prompt-visible tristate
# with no default that neither the arm64 defconfig nor sdm670.config enables.
# Left at its default the =y request above would be silently dropped, so ask
# for it explicitly.
CONFIG_BACKLIGHT_CLASS_DEVICE=y

# DRM_MSM is a tristate whose Kconfig entry says
#   depends on QCOM_AOSS_QMP || QCOM_AOSS_QMP=n
#   depends on QCOM_OCMEM || QCOM_OCMEM=n
#   depends on QCOM_LLCC || QCOM_LLCC=n
#   depends on QCOM_COMMAND_DB || QCOM_COMMAND_DB=n
# The arm64 defconfig leaves QCOM_LLCC=m, which is exactly what would silently
# downgrade DRM_MSM to =m, so the capabilities the SoC actually has are asked
# for as built-ins: sdm670.dtsi has nodes for AOSS QMP (aoss_qmp), LLCC
# (system-cache-controller@1100000, "qcom,sdm670-llcc") and the command DB.
CONFIG_QCOM_AOSS_QMP=y
CONFIG_QCOM_COMMAND_DB=y
CONFIG_QCOM_LLCC=y
# OCMEM is unused on this SoC (sdm670.dtsi has no ocmem node). =n satisfies
# DRM_MSM's dependency just as well and avoids shipping a driver that can
# never bind; what must not happen is OCMEM=m.
CONFIG_QCOM_OCMEM=n
# sirius uses an EA8074-class AMOLED; the driver is the one added by the patch
# above (qcom,mdss-dsi-panel compatible "samsung,ea8074").

# --- Touchscreen: ST FTS ---
CONFIG_TOUCHSCREEN_STMFTS=y

# --- PMIC / charger / fuel gauge / haptics ---
CONFIG_BATTERY_QCOM_FG=m
CONFIG_CHARGER_QCOM_SMB2=m
CONFIG_QCOM_SPMI_RRADC=m
CONFIG_INPUT_QCOM_SPMI_HAPTICS=m

# --- WiFi / BT (WCN3990 over QMI) ---
CONFIG_ATH10K=m
CONFIG_ATH10K_SNOC=m
CONFIG_QCOM_QMI_HELPERS=y

# --- Remoteproc / rmtfs / pd-mapper ---
CONFIG_QCOM_Q6V5_PAS=y
CONFIG_QCOM_Q6V5_MSS=y
CONFIG_QCOM_PD_MAPPER=m
CONFIG_QCOM_RMTFS_MEM=y

# --- GPU (Adreno 616, a6xx) ---
# The Adreno driver is a DRM component of the MSM master, but its firmware is
# requested lazily on the first DRM open (msm_open() -> load_gpu(), see
# drivers/gpu/drm/msm/msm_drv.c), not while the master binds. The display path
# therefore does not depend on qcom/sdm710/sirius/*.mbn being on the device.
# No other device's firmware is substituted here; GPU acceleration waits until
# this device's own firmware is available.
CONFIG_DRM_MSM_GPU_STATE=y

# --- Console ---
CONFIG_SERIAL_QCOM_GENI=y
CONFIG_SERIAL_QCOM_GENI_CONSOLE=y

# --- Framebuffer console, so early kernel logs land on the panel ---
# (sirius has no accessible UART; the screen is the only console)
CONFIG_DRM_SIMPLEDRM=y
CONFIG_DRM_FBDEV_EMULATION=y
CONFIG_FRAMEBUFFER_CONSOLE=y
CONFIG_FRAMEBUFFER_CONSOLE_DETECT_PRIMARY=y
CONFIG_VT=y
CONFIG_VT_CONSOLE=y
CONFIG_LOGO=n

# --- pstore/ramoops: capture the kernel log if early boot dies ---
# (there is no UART, so this is the only crash log we can retrieve)
CONFIG_PSTORE=y
CONFIG_PSTORE_DEFAULT_KMSG_BYTES=10240
CONFIG_PSTORE_CONSOLE=y
CONFIG_PSTORE_PMSG=y
CONFIG_PSTORE_RAM=y

# Store the crash log uncompressed so it can be read directly from TWRP
# CONFIG_PSTORE_COMPRESS is not set
CONFIG_PSTORE_FTRACE=y
