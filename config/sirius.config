# Sirius (Xiaomi Mi 8 SE) bring-up config fragment.
# Merged on top of arch/arm64/configs/sdm670.config from sdm670-mainline/linux.

CONFIG_LOCALVERSION="-sirius"

# --- Storage: UFS rootfs + MicroSD ---
CONFIG_SCSI_UFS_QCOM=y
CONFIG_PHY_QCOM_QMP_UFS=y

# --- USB (debug lifeline: USB gadget network + serial) ---
CONFIG_USB_GADGET=y
CONFIG_USB_CONFIGFS=y
CONFIG_USB_CONFIGFS_RNDIS=y
CONFIG_USB_CONFIGFS_ECM=y
CONFIG_USB_CONFIGFS_F_FS=y

# --- Display: MSM DSI/MDP + panel ---
CONFIG_DRM=y
CONFIG_DRM_MSM=y
# sirius uses an EA8074-class AMOLED; no upstream driver yet.

# --- Touchscreen: ST FTS ---
CONFIG_TOUCHSCREEN_STMFTS=y

# --- PMIC / charger / fuel gauge / haptics ---
CONFIG_BATTERY_QCOM_FG=m
CONFIG_CHARGER_QCOM_SMB2=m
CONFIG_QCOM_SPMI_RRADC=m
CONFIG_INPUT_QCOM_SPMI_HAPTICS=m

# --- WiFi / BT (WCN3990 over QMI) ---
CONFIG_ATH10K=m
CONFIG_ATH10K_SNOC=m
CONFIG_QCOM_QMI_HELPERS=y

# --- Remoteproc / rmtfs / pd-mapper ---
CONFIG_QCOM_Q6V5_PAS=y
CONFIG_QCOM_Q6V5_MSS=y
CONFIG_QCOM_PD_MAPPER=m
CONFIG_QCOM_RMTFS_MEM=y

# --- GPU (Adreno 616, a6xx) ---
CONFIG_DRM_MSM_GPU_STATE=y

# --- Console ---
CONFIG_SERIAL_QCOM_GENI=y
CONFIG_SERIAL_QCOM_GENI_CONSOLE=y

# --- Framebuffer console, so early kernel logs land on the panel ---
# (sirius has no accessible UART; the screen is the only console)
CONFIG_DRM_SIMPLEDRM=y
CONFIG_DRM_FBDEV_EMULATION=y
CONFIG_FRAMEBUFFER_CONSOLE=y
CONFIG_FRAMEBUFFER_CONSOLE_DETECT_PRIMARY=y
CONFIG_VT=y
CONFIG_VT_CONSOLE=y
CONFIG_LOGO=n

# --- pstore/ramoops: capture the kernel log if early boot dies ---
# (there is no UART, so this is the only crash log we can retrieve)
CONFIG_PSTORE=y
CONFIG_PSTORE_DEFAULT_KMSG_BYTES=10240
CONFIG_PSTORE_CONSOLE=y
CONFIG_PSTORE_PMSG=y
CONFIG_PSTORE_RAM=y

# Store the crash log uncompressed so it can be read directly from TWRP
# CONFIG_PSTORE_COMPRESS is not set
CONFIG_PSTORE_FTRACE=y
